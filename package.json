    "is-path-inside": "^4.0.0",
    "lodash": "^4.17.5",
    "resolve-from": "^5.0.0",
    "resolve-pkg": "^3.0.1",
    "semver": "^7.5.0",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@folio/eslint-config-stripes": "^10.0.0",
