{
  "name": "@folio/stripes-build",
  "version": "3.0.0",
  "description": "Stripes Build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folio-org/stripes-build.git"
  },
  "publishConfig": {
    "registry": "https://repository.folio.org/repository/npm-folio/"
  },
  "type": "module",
  "license": "Apache-2.0",
